* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}
body {
    font-family: "Arial", sans-serif;
    background: #f8f5ef;
    color: #3d3028;
}
.welcome-screen {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background:
        linear-gradient(rgba(30, 20, 15, 0.58), rgba(30, 20, 15, 0.58)),
        url("IMG_0308.jpeg") center/cover;
    transition: opacity 0.8s ease, visibility 0.8s ease;
}
.welcome-screen.hide {
    opacity: 0;
    visibility: hidden;
}
.welcome-content {
    width: 90%;
    max-width: 430px;
    padding: 40px 25px;
    border: 1px solid rgba(255,255,255,0.55);
    border-radius: 25px;
    background: rgba(255,255,255,0.12);
    backdrop-filter: blur(8px);
    color: white;
}
.rings {
    font-size: 50px;
    margin-bottom: 15px;
    animation: pulse 2s infinite;
}
.welcome-content h1 {
    font-size: 34px;
    margin-bottom: 12px;
}
.welcome-content p {
    font-size: 25px;
    margin-bottom: 30px;
}
#openInvitation {
    border: 0;
    padding: 14px 35px;
    border-radius: 30px;
    background: white;
    color: #6b5140;
    font-size: 17px;
    cursor: pointer;
}
.invitation {
    display: block;
    min-height: 100vh;
}
.hero {
    min-height: 100vh;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
        url("IMG_0308.jpeg") center/cover no-repeat;
    text-align: center;
    color: white;
}
.hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(25, 18, 14, 0.62);
}
.hero-content {
    position: relative;
    z-index: 2;
    width: 90%;
    max-width: 500px;
}
.small-title {
    font-size: 15px;
    margin-bottom: 35px;
}
.hero-content h2 {
    font-size: 22px;
    font-weight: normal;
    margin-bottom: 20px;
}
.hero-content h1 {
    font-size: 50px;
    line-height: 1.5;
}
.hero-content h1 span {
    font-size: 30px;
    margin: 0 8px;
}
.love-text {
    font-size: 20px;
    margin-top: 20px;
}
.ornament {
    font-size: 28px;
    margin: 20px 0;
}
.welcome-text {
    line-height: 2;
    font-size: 16px;
}
.details {
    padding: 70px 20px;
    text-align: center;
    background: #f8f5ef;
}
.details h2 {
    font-size: 30px;
}
.line {
    width: 70px;
    height: 2px;
    margin: 18px auto 35px;
    background: #9a806b;
}
.date-box {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin-bottom: 8px;
}
.date-box span {
    font-size: 16px;
}
.date-box strong {
    font-size: 65px;
    font-weight: normal;
}
.day {
    font-size: 19px;
    margin-bottom: 45px;
}
.info {
    display: flex;
    justify-content: center;
    gap: 18px;
    flex-wrap: wrap;
    margin-bottom: 45px;
}
.info-item {
    width: 170px;
    padding: 25px 15px;
    background: white;
    border-radius: 20px;
    box-shadow: 0 8px 25px rgba(70, 50, 40, 0.08);
}
.icon {
    display: block;
    font-size: 28px;
    margin-bottom: 12px;
}
.info-item h3 {
    margin-bottom: 10px;
}
.info-item p {
    line-height: 1.8;
    font-size: 14px;
}
.photos {
    max-width: 600px;
    margin: auto;
    display: flex;
    flex-direction: column;
    gap: 22px;
}
.photo-card {
    overflow: hidden;
    border-radius: 22px;
    box-shadow: 0 10px 30px rgba(60,40,30,0.12);
}
.photo-card img {
    display: block;
    width: 100%;
    height: auto;
}
.closing {
    margin: 45px 0 25px;
    line-height: 2;
    font-size: 18px;
}
.music-button {
    border: 1px solid #9a806b;
    background: transparent;
    color: #5e493b;
    padding: 11px 24px;
    border-radius: 30px;
    cursor: pointer;
}
@keyframes pulse {
    0%, 100% {
        transform: scale(1);
    }
    50% {
        transform: scale(1.12);
    }
}
@media (max-width: 500px) {
    .hero-content h1 {
        font-size: 43px;
    }
    .hero-content h1 span {
        font-size: 25px;
    }
    .info-item {
        width: 155px;
    }
}
