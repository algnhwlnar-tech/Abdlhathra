<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>دعوة زفاف عبدالله وعذراء</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <!-- شاشة البداية -->
    <div id="welcomeScreen" class="welcome-screen">
        <div class="welcome-content">
            <div class="rings">💍</div>
            <h1>دعوة زفاف</h1>
            <p>عبدالله وعذراء</p>
            <button id="openInvitation">افتح الدعوة</button>
        </div>
    </div>
    <!-- الموسيقى -->
    <audio id="weddingMusic" loop>
        <source src="87C340CF-0FC2-47E7-A0C1-5A543034CE7B.m4a" type="audio/mp4">
    </audio>
    <!-- الدعوة -->
    <main id="invitation" class="invitation">
        <section class="hero">
            <div class="hero-overlay"></div>
            <div class="hero-content">
                <p class="small-title">بسم الله الرحمن الرحيم</p>
                <h2>يدعوكم العروسان</h2>
                <h1>
                    عبدالله
                    <span>&</span>
                    عذراء
                </h1>
                <p class="love-text">زواجُ الملك من أميرته</p>
                <div class="ornament">✦</div>
                <p class="welcome-text">
                    بكل الحب والفرح، نتشرف بحضوركم<br>
                    ومشاركتنا أجمل لحظات العمر
                </p>
            </div>
        </section>
        <!-- التفاصيل -->
        <section class="details">
            <h2>موعدنا معكم</h2>
            <div class="line"></div>
            <div class="date-box">
                <span>سبتمبر</span>
                <strong>19</strong>
                <span>2026</span>
            </div>
            <p class="day">السبت</p>
            <div class="info">
                <div class="info-item">
                    <span class="icon">🕓</span>
                    <h3>الوقت</h3>
                    <p>من الساعة 3:00<br>إلى الساعة 5:00 مساءً</p>
                </div>
                <div class="info-item">
                    <span class="icon">📍</span>
                    <h3>المكان</h3>
                    <p>قاعة مارينا</p>
                </div>
            </div>
            <!-- الصور -->
            <div class="photos">
                <div class="photo-card">
                    <img src="IMG_0308.jpeg" alt="عبدالله وعذراء">
                </div>
                <div class="photo-card">
                    <img src="IMG_0309.jpeg" alt="عبدالله وعذراء">
                </div>
            </div>
            <p class="closing">
                حضوركم فرحتنا<br>
                ووجودكم أجمل هدية لنا 🤍
            </p>
            <button id="musicButton" class="music-button">
                🎵 إيقاف الموسيقى
            </button>
        </section>
    </main>
    <script src="script.js"></script>
</body>
</html>
